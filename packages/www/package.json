{
  "name": "@divriots/jampack-www",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check && tsc",
    "build-jampack": "cd ../.. && pnpm i && pnpm build && cd packages/www",
    "build": "pnpm build-jampack && astro build && cp -fr public/features dist && pnpm build-optimize",
    "build-optimize": "node ../../dist/index.js dist --exclude features/** --fail",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@algolia/client-search": "^4.23.3",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/preact": "^6.1.1",
    "@astrojs/react": "^7.1.1",
    "@docsearch/css": "^3.6.0",
    "@docsearch/react": "^3.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "ansi-to-html": "^0.7.2",
    "astro": "^7.4.2",
    "dir-compare": "^4.2.0",
    "front-matter": "^4.0.2",
    "preact": "^10.29.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.106.1"
  },
  "devDependencies": {
    "ultrahtml": "^1.5.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
